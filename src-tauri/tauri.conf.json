{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yike-focus-timer",
  "version": "0.1.0",
  "identifier": "app.yike.focustimer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "一刻 · 激励学习计时器",
        "url": "index.html",
        "width": 1180,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560
      },
      {
        "label": "mini",
        "create": false,
        "title": "一刻 · 悬浮窗",
        "url": "mini.html",
        "width": 240,
        "height": 120,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "shadow": true
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
