{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window control for the main and floating windows. No file, shell or network access.",
  "windows": ["main", "mini"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
